  "main": "index.js",
  "scripts": {
    "build:validation": "pnpm --filter @journalpilot/validation build",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint .",
