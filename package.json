    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "prisma": "^7.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "pnpm": {
    "overrides": {
      "body-parser": "2.4.0",
      "fast-uri": "3.1.9",
